{
  "name": "veilpass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-node.mjs && next dev apps/web --hostname 127.0.0.1",
    "build": "node scripts/check-node.mjs && next build apps/web",
    "start": "node scripts/check-node.mjs && next start apps/web --hostname 127.0.0.1",
    "contract:compile": "node scripts/compile.mjs",
    "contract:check": "node scripts/compile.mjs --skip-zk",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "issuer:setup": "node scripts/check-node.mjs && tsx scripts/issuer-setup.ts",
    "proof-server": "docker compose up -d proof-server",
    "toolchain:install": "node scripts/install-compact.mjs",
    "test:e2e": "node scripts/check-node.mjs && tsx scripts/local-e2e.ts",
    "test:ui": "node scripts/check-node.mjs && node scripts/ui-check.mjs",
    "demo:local": "node scripts/check-node.mjs && VEILPASS_INTERACTIVE=1 tsx scripts/local-e2e.ts",
    "demo:record": "node scripts/check-node.mjs && VEILPASS_RECORD=1 VEILPASS_BROWSER_E2E=1 tsx scripts/local-e2e.ts",
    "lifecycle:check": "node scripts/compile.mjs --lifecycle --skip-zk",
    "lifecycle:compile": "node scripts/compile.mjs --lifecycle",
    "demo:verifiers": "node scripts/check-node.mjs && node --import tsx scripts/two-verifiers.ts",
    "test:lifecycle:e2e": "node scripts/check-node.mjs && tsx scripts/lifecycle-e2e.ts",
    "test:v2:ui": "node scripts/check-node.mjs && node scripts/v2-ui-check.mjs",
    "benchmark:lifecycle": "node --import tsx scripts/lifecycle-benchmark.ts",
    "test:theme:ui": "node scripts/check-node.mjs && node scripts/theme-ui-check.mjs",
    "test:live:browser": "node scripts/check-node.mjs && VEILPASS_BUILD_DIR=.next-live-demo npm run build && VEILPASS_BROWSER_E2E=1 tsx scripts/lifecycle-e2e.ts",
    "demo:live": "node scripts/check-node.mjs && VEILPASS_BUILD_DIR=.next-live-demo npm run build && VEILPASS_LIVE_DEMO=1 tsx scripts/lifecycle-e2e.ts",
    "test:live:ui": "node scripts/check-node.mjs && node scripts/live-ui-check.mjs",
    "test:hosted:ui": "node scripts/vercel-ui-check.mjs",
    "dev:signed": "node scripts/signed-dev.mjs",
    "issuer:token": "node scripts/signed-dev.mjs --token",
    "test:signed:ui": "node --import tsx scripts/signed-ui-check.mjs",
    "test:signed:network": "node --import tsx scripts/signed-network-e2e.ts",
    "signed:check": "node integrations/issuance/compile.mjs && node integrations/issuance/compile.mjs --authorization",
    "preprod:check": "node scripts/preprod-check.mjs",
    "test:signed:browser": "VEILPASS_SIGNED_BROWSER=only node --import tsx scripts/signed-network-e2e.ts",
    "signed:artifacts": "node scripts/signed-artifacts.mjs",
    "signed:assets": "node scripts/signed-assets.mjs",
    "test:signed:api": "node --import tsx scripts/signed-network-api-check.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.2",
    "lucide-react": "0.468.0",
    "next": "15.5.28",
    "pg": "8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "pino": "10.3.1",
    "tailwindcss": "4.1.18",
    "testcontainers": "12.1.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "postcss": "8.5.28"
  },
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "integrations/issuance"
  ]
}
